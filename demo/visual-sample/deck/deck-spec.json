      "role": "strategy",
      "layout": "cards",
      "kicker": "01 / STRATEGY",
      "title": "从被看见，到被理解，再到被选择",
      "subtitle": "同一套内容必须连续解决注意、理解和行动三个问题。",
      "blocks": [
        {
          "type": "cards",
          "items": [
            {
              "title": "先让问题相关",
              "text": "用真实生活任务建立注意，不从成分堆砌开始。"
            },
            {
              "title": "再让价值可懂",
              "text": "把专业证据转成消费者语言、画面和选择标准。"
            },
            {
              "title": "最后让行动简单",
              "text": "用场景、商品和权益把理解推进为每天的选择。"
            }
          ]
        }
      ],
